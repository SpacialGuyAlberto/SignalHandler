digraph Train {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", penwidth=1.2];
    edge [color="#1A73E8", penwidth=1.2, arrowhead="vee"];

    CAD [label="Generador CAD Procedural
Cilindros, Codos 90°/45°,
Tubos aplastados, Raíces", fillcolor="#ECEFF1", color="#607D8B"];
    FDTD [label="Simulador FDTD (gprMax)
Dispersión Cole-Cole
Asfalto, Arena, Arcilla", fillcolor="#E8F0FE", color="#1A73E8"];
    DATA [label="Dataset 3D Sintético
20,000 pares:
(Radargrama <-> Malla GT)", fillcolor="#E8F0FE", color="#1A73E8"];

    subgraph cluster_loss {
        label="Pérdidas Guiadas por la Física (PINN)"; fontname="Helvetica-Bold"; fontsize=9;
        fillcolor="#FEF7E0"; color="#B06000"; style="rounded,dashed";
        L1 [label="L_SDF: Regresión de Distancia"];
        L2 [label="L_Eikonal: ||nabla f|| = 1"];
        L3 [label="L_Chamfer: Distancia a Malla"];
        L4 [label="L_Wave: Ecuación de Onda"];
    }

    OPT [label="Entrenamiento PyTorch
AdamW + Cosine Decay
Exportación ONNX (FP16)", fillcolor="#E6F4EA", color="#137333"];
    CPP [label="Motor gpr3d C++20
Inferencia local en CPU/GPU
sin dependencias de Python", fillcolor="#FCE8E6", color="#C5221F"];

    CAD -> FDTD -> DATA;
    DATA -> L1; DATA -> L2; DATA -> L3; DATA -> L4;
    L1 -> OPT; L2 -> OPT; L3 -> OPT; L4 -> OPT;
    OPT -> CPP;
}